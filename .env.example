# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
TIME_ZONE=UTC

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grckits
DB_CONN_MAX_AGE=60

# --- Stripe (use test keys locally: https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen --forward-to localhost:8000/checkout/webhook/stripe/`
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# --- Email ---
# Dev defaults to the console backend. In production use SMTP (Postmark, SES, Resend...).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GRCkits <hello@grckits.com>
ADMIN_EMAIL=admin@grckits.com

# --- Files ---
# Paid downloads live here, outside the public media root.
PRIVATE_MEDIA_ROOT=./private_media
DOWNLOAD_LINK_MAX_USES=10
DOWNLOAD_LINK_EXPIRY_DAYS=365

# --- Tailwind ---
TAILWIND_CLI_VERSION=latest

# --- Production only ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
